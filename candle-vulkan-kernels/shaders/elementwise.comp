// f32 elementwise kernels: broadcast binary ops (add/sub/mul/div) and
// unary ops (sigmoid/silu/exp/sqrt/sin/cos/neg), one entry point each.
//
// WGSL (rather than GLSL) because naga's GLSL frontend synthesizes exactly
// one entry point per module, named `main`, while each op here needs its
// own entry point so the pipeline cache can select it by name.

struct Params {
    total: u32,
    lhs_ndim: u32,
    rhs_ndim: u32,
    l0: u32,
    l1: u32,
    l2: u32,
    l3: u32,
    r0: u32,
    r1: u32,
    r2: u32,
    r3: u32,
}

// Single push-constant block shared by every entry point: the unary ops
// read `total`, the binary ops read the full broadcast descriptor. Two
// separate `var<immediate>` blocks in one module are not delivered
// reliably by the RADV driver.
@group(0) @binding(0)
var<storage, read> in_buf: array<f32>;

@group(0) @binding(1)
var<storage, read> rhs_buf: array<f32>;

@group(0) @binding(2)
var<storage, read_write> out_buf: array<f32>;

var<immediate> params: Params;

fn ldim(d: u32) -> u32 {
    if (d == 0u) {
        return params.l0;
    }
    if (d == 1u) {
        return params.l1;
    }
    if (d == 2u) {
        return params.l2;
    }
    return params.l3;
}

fn rdim(j: u32) -> u32 {
    if (j == 0u) {
        return params.r0;
    }
    if (j == 1u) {
        return params.r1;
    }
    if (j == 2u) {
        return params.r2;
    }
    return params.r3;
}

// Offset in the contiguous rhs of the element at flat index `i` of the
// contiguous lhs. The rhs is right-aligned against the lhs; a rhs
// dimension of 1 is broadcast (its index is always 0), and a 0-dim rhs is
// a scalar (the offset is always 0).
fn rhs_offset(i: u32) -> u32 {
    if (params.rhs_ndim == 0u) {
        return 0u;
    }
    var idx: vec4<u32> = vec4<u32>(0u, 0u, 0u, 0u);
    var rem = i;
    for (var d: u32 = 0u; d < params.lhs_ndim; d += 1u) {
        // Decompose right to left over the lhs dimensions.
        let dim = ldim(params.lhs_ndim - 1u - d);
        idx[params.lhs_ndim - 1u - d] = rem % dim;
        rem = rem / dim;
    }
    var off = 0u;
    for (var j: u32 = 0u; j < params.rhs_ndim; j += 1u) {
        let r = rdim(j);
        let lidx = idx[params.lhs_ndim - params.rhs_ndim + j];
        off = off * r + select(0u, lidx, r != 1u);
    }
    return off;
}

@compute @workgroup_size(256)
fn main_add(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        out_buf[i] = in_buf[i] + rhs_buf[rhs_offset(i)];
    }
}

@compute @workgroup_size(256)
fn main_sub(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        out_buf[i] = in_buf[i] - rhs_buf[rhs_offset(i)];
    }
}

@compute @workgroup_size(256)
fn main_mul(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        out_buf[i] = in_buf[i] * rhs_buf[rhs_offset(i)];
    }
}

@compute @workgroup_size(256)
fn main_div(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        out_buf[i] = in_buf[i] / rhs_buf[rhs_offset(i)];
    }
}

@compute @workgroup_size(256)
fn main_sigmoid(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        let x = in_buf[i];
        out_buf[i] = 1.0 / (1.0 + exp(-x));
    }
}

@compute @workgroup_size(256)
fn main_silu(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        let x = in_buf[i];
        out_buf[i] = x / (1.0 + exp(-x));
    }
}

@compute @workgroup_size(256)
fn main_exp(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        out_buf[i] = exp(in_buf[i]);
    }
}

@compute @workgroup_size(256)
fn main_sqrt(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        out_buf[i] = sqrt(in_buf[i]);
    }
}

@compute @workgroup_size(256)
fn main_sin(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        out_buf[i] = sin(in_buf[i]);
    }
}

@compute @workgroup_size(256)
fn main_cos(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        out_buf[i] = cos(in_buf[i]);
    }
}

@compute @workgroup_size(256)
fn main_neg(@builtin(global_invocation_id) gid: vec3<u32>) {
    let i = gid.x;
    if (i < params.total) {
        out_buf[i] = -in_buf[i];
    }
}
