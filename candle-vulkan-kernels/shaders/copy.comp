#version 460

layout(local_size_x = 256) in;

layout(binding = 0) buffer Src {
    float data[];
} src_buf;

layout(binding = 1) buffer Dst {
    float data[];
} dst_buf;

layout(push_constant) uniform Params {
    uint total;
    uint ndim;
    uint d0;
    uint d1;
    uint d2;
    uint d3;
    uint sd0;
    uint sd1;
    uint sd2;
    uint sd3;
    uint dd0;
    uint dd1;
    uint dd2;
    uint dd3;
    uint src_off;
    uint dst_off;
} params;

uint dim_at(uint ndim, uint d, uint d0, uint d1, uint d2, uint d3) {
    if (d == 0u) {
        return d0;
    }
    if (d == 1u) {
        return d1;
    }
    if (d == 2u) {
        return d2;
    }
    return d3;
}

// Copies `total` elements between two strided views of the same shape
// (up to 4 dims, right-aligned). Both the source and the destination may
// carry arbitrary strides; a stride-0 (broadcast) source is allowed.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.total) {
        return;
    }
    uint s_off = params.src_off;
    uint d_off = params.dst_off;
    uint rem = i;
    for (uint d = 0u; d < params.ndim; d++) {
        uint idx_dim = params.ndim - 1u - d;
        uint size = dim_at(params.ndim, idx_dim, params.d0, params.d1, params.d2, params.d3);
        uint idx = rem % size;
        rem = rem / size;
        uint sd = 0u;
        uint dd = 0u;
        if (idx_dim == 0u) {
            sd = params.sd0;
            dd = params.dd0;
        } else if (idx_dim == 1u) {
            sd = params.sd1;
            dd = params.dd1;
        } else if (idx_dim == 2u) {
            sd = params.sd2;
            dd = params.dd2;
        } else {
            sd = params.sd3;
            dd = params.dd3;
        }
        s_off = s_off + idx * sd;
        d_off = d_off + idx * dd;
    }
    dst_buf.data[d_off] = src_buf.data[s_off];
}
