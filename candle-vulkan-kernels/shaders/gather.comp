#version 460

layout(local_size_x = 256) in;

// `ids` are u32 row indices into `emb`, which is stored row-major with
// `dim` columns. One workgroup item gathers one row.
layout(binding = 0) buffer Ids {
    uint data[];
} ids_buf;

layout(binding = 1) buffer Emb {
    float data[];
} emb_buf;

layout(binding = 2) buffer Out {
    float data[];
} out_buf;

layout(push_constant) uniform Params {
    uint rows;
    uint dim;
} params;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.rows) {
        return;
    }
    uint row = ids_buf.data[i];
    for (uint j = 0u; j < params.dim; j++) {
        out_buf.data[i * params.dim + j] = emb_buf.data[row * params.dim + j];
    }
}
