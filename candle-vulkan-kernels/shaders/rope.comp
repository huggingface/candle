// Non-interleaved rotary embeddings for (b, h, t, d) f32 tensors.
// src: (b, h, t, d), contiguous. cos/sin: (t, d/2) [batched] or
// (b, t, d/2) [unbatched], contiguous. For row r = ((b_i*h)+h_i)*t+t_i and
// i_d in 0..d/2: i1 = r*d + i_d, i2 = i1 + d/2,
// i_cs = t_i*(d/2) + i_d (+ b_i*t*(d/2) when unbatched), and
//   out[i1] = src[i1]*cos[i_cs] - src[i2]*sin[i_cs]
//   out[i2] = src[i1]*sin[i_cs] + src[i2]*cos[i_cs]
@group(0) @binding(0)
var<storage, read> in_buf: array<f32>;
@group(0) @binding(1)
var<storage, read> cos_buf: array<f32>;
@group(0) @binding(2)
var<storage, read> sin_buf: array<f32>;
@group(0) @binding(3)
var<storage, read_write> out_buf: array<f32>;
struct Params {
    rows: u32,
    h: u32,
    t: u32,
    d: u32,
    unbatched: u32,
};
var<immediate> params: Params;
@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
    let row = gid.x;
    if (row >= params.rows) {
        return;
    }
    let half = params.d / 2u;
    let i_d = gid.y;
    if (i_d >= half) {
        return;
    }
    let b_i = row / (params.h * params.t);
    let t_i = row % params.t;
    var i_cs = t_i * half + i_d;
    if (params.unbatched == 1u) {
        i_cs = i_cs + b_i * params.t * half;
    }
    let i1 = row * params.d + i_d;
    let i2 = i1 + half;
    let x1 = in_buf[i1];
    let x2 = in_buf[i2];
    let c = cos_buf[i_cs];
    let s = sin_buf[i_cs];
    out_buf[i1] = x1 * c - x2 * s;
    out_buf[i2] = x1 * s + x2 * c;
}
