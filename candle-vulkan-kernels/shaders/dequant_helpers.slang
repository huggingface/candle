// Helpers shared by the quantized dequant and fused GEMM kernels:
// f16_bits_to_f32 converts an f16 bit pattern (uint16_t) to float, and sbyte
// converts a byte read from a uint buffer to a signed int8 value.
module dequant_helpers;

public float f16_bits_to_f32(uint16_t h)
{
    uint sign = (h >> 15) & 1u;
    uint exp = (h >> 10) & 0x1Fu;
    uint mant = h & 0x3FFu;
    uint32_t f;
    if (exp == 0u)
    {
        if (mant == 0u)
        {
            f = sign << 31; // signed zero
        }
        else
        {
            uint m = mant;
            uint shift = 0u;
            while ((m & 0x400u) == 0u)
            {
                m <<= 1;
                shift += 1;
            }
            m &= 0x3FFu;
            f = (sign << 31) | ((113u - shift) << 23) | (m << 13);
        }
    }
    else if (exp == 31u)
    {
        f = (sign << 31) | 0x7F800000u | (mant << 13);
    }
    else
    {
        f = (sign << 31) | ((exp + 112u) << 23) | (mant << 13);
    }
    return asfloat(f);
}

public int sbyte(uint u)
{
    return (u & 0x80u) != 0u ? (int(u) - 256) : int(u);
}
